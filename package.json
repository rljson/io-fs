{
  "name": "@rljson/io-fs",
  "version": "0.0.1",
  "packageManager": "pnpm@10.6.2",
  "description": "File system implementation of @rljson/io",
  "homepage": "https://github.com/rljson/io-fs",
  "bugs": "https://github.com/rljson/io-fs/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/io-fs.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "npx vite build && tsc && cp README* dist && mkdir dist/src && cp src/example.ts dist/src",
    "test": "npx vitest run --coverage && npm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build && npm run test",
    "lint": "npx eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true npm test"
  },
  "devDependencies": {
    "@rljson/dna-rljson": "^0.2.0",
    "@tssuite/helix-js": "^0.3.0",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.5.3",
    "eslint-plugin-tsdoc": "^0.5.3",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1",
    "vitest-dom": "^0.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
